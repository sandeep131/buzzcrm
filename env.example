# Copy to .env and fill in. Never commit .env.
# No hardcoded config anywhere in source — everything comes from here.
#
#   cp env.example .env
#
# (This file is named without a leading dot because the Zeus MCP connector
#  blocks writes to .env* paths. Rename on copy.)

DATABASE_URL=postgresql+psycopg://buzzcrm:buzzcrm@localhost:5433/buzzcrm
ENVIRONMENT=local
APP_NAME=BuzzCRM
